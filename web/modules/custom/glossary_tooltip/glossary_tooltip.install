<?php

/**
 * @file
 * Install / uninstall hooks for the Glossary Tooltip module.
 *
 * The taxonomy term entity ships with a built-in "description"
 * base field (text_long). The module reuses it for tooltip bodies
 * instead of adding a custom field, which keeps configuration
 * minimal and removes the need to manage field storage on
 * install / uninstall.
 */

use Drupal\node\Entity\Node;
use Drupal\taxonomy\Entity\Term;
use Drupal\taxonomy\Entity\Vocabulary;

/**
 * Implements hook_install().
 *
 * Creates the "Glossary" vocabulary and seeds demo content. The
 * function is idempotent — safe to call on a site that already has
 * the vocabulary or that has already been seeded.
 */
function glossary_tooltip_install() {
  $terms = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->loadByProperties(['vid' => 'glossary']);
  foreach ($terms as $term) {
    $term->delete();
  }

  if (!Vocabulary::load('glossary')) {
    Vocabulary::create([
      'vid' => 'glossary',
      'name' => 'Glossary',
      'description' => 'Glossary terms shown as tooltips inside site content.',
    ])->save();
  }

  // Seed demo content. Each helper guards against duplicates so the
  // hook stays safe on repeated invocations (e.g. from kernel tests
  // or recovery reinstalls).
  _glossary_tooltip_seed_terms();
  if (\Drupal::moduleHandler()->moduleExists('node')) {
    _glossary_tooltip_seed_pages();
  }
}

/**
 * Seeds five demo glossary terms.
 *
 * Each term is created only if no term with the same name already
 * exists, so calling this from a partial test setup or a recovery
 * reinstall is safe.
 */
function _glossary_tooltip_seed_terms(): void {
  $terms = [
    [
      'API',
      'Application Programming Interface — a defined set of functions and rules that lets one piece of software interact with another in a predictable way.',
    ],
    [
      'Field',
      'A reusable, typed data container attached to an entity bundle. Fields hold a single value or repeating values and can be shared across content types.',
    ],
    [
      'Route',
      'A mapping from a URL pattern to a controller. Drupal builds its routing table from YAML files declared by modules and dispatches each request to the matching controller.',
    ],
    [
      'Block',
      'A reusable piece of content placed into a region defined by the active theme. Blocks may be static content or rendered dynamically from a plugin.',
    ],
    [
      'View',
      'A configurable database query plus one or more displays — pages, blocks, feeds — provided by the Views module and authored entirely through the admin UI.',
    ],
  ];

  $storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  foreach ($terms as [$name, $description]) {
    $existing = $storage->loadByProperties(['vid' => 'glossary', 'name' => $name]);
    if ($existing) {
      continue;
    }
    Term::create([
      'vid' => 'glossary',
      'name' => $name,
      'description' => [
        'value' => $description,
        'format' => 'plain_text',
      ],
      'status' => 1,
    ])->save();
  }
}

/**
 * Seeds two demo Basic page nodes featuring glossary terms.
 *
 * Skips silently if the "page" content type does not exist or if a
 * page with the same title already lives in the database.
 */
function _glossary_tooltip_seed_pages(): void {
  $entityTypeManager = \Drupal::entityTypeManager();
  if (!$entityTypeManager->getStorage('node_type')->load('page')) {
    return;
  }

  $pages = [
    [
      'title' => 'Glossary tooltip: getting started',
      'body' => <<<HTML
<p>This Basic page demonstrates the Glossary tooltip module. Every word below that matches a published glossary term is highlighted automatically — hover or focus it to see the description.</p>
<p>A modern Drupal site is built from a small number of reusable concepts. Each piece of structured data is exposed as a Field on an entity. Each public URL is wired up by a Route that hands the request to a controller. Visual placement is handled by the Block system, which uses regions defined by the active theme.</p>
<p>When the same data needs to be served programmatically — to a single page application, a mobile client or an external system — Drupal exposes it through an API. Editorial pages can be assembled from a View, which queries content and renders it without writing PHP.</p>
HTML,
    ],
    [
      'title' => 'Why a glossary helps editors and readers',
      'body' => <<<HTML
<p>Long-form content quickly accumulates terminology. A short, in-place explanation lets readers stay in flow instead of jumping to a definitions page.</p>
<p>For editors, the Block, View and Field abstractions in Drupal already make it easy to assemble a glossary admin experience: a vocabulary of terms is configured once and surfaces wherever an API consumer or a Route renders body content.</p>
<p>Because the Glossary tooltip filter participates in Drupal's standard text format pipeline, the rewritten markup is cached per (text, format, language). When an editor edits a term, the relevant cache tag is invalidated and only the pages that actually used that term are recomputed.</p>
HTML,
    ],
  ];

  $nodeStorage = $entityTypeManager->getStorage('node');
  foreach ($pages as $p) {
    $existing = $nodeStorage->loadByProperties([
      'type' => 'page',
      'title' => $p['title'],
    ]);
    if ($existing) {
      continue;
    }
    Node::create([
      'type' => 'page',
      'title' => $p['title'],
      'body' => [
        'value' => $p['body'],
        'format' => 'basic_html',
      ],
      'status' => 1,
      'uid' => 1,
    ])->save();
  }
}
